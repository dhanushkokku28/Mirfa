{
  "version": 2,
  "outputDirectory": "",
  "installCommand": "cd ../.. && pnpm install; pnpm --filter @mirfa/crypto... build; pnpm --filter @mirfa/api... build",
  "buildCommand": "cd ../.. && pnpm --filter @mirfa/api... build",
  "functions": {
    "api/index.mjs": {
      "runtime": "@vercel/node@3.2.2",
      "includeFiles": "{apps/api/dist/**,packages/crypto/dist/**,packages/crypto/package.json}"
    }
  },
  "rewrites": [
    {
      "source": "/(.*)",
      "destination": "/api"
    }
  ]
}

