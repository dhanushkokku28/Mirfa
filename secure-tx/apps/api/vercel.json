{
  "version": 2,
  "outputDirectory": "",
  "installCommand": "cd ../.. && pnpm install",
  "buildCommand": "cd ../.. && pnpm --filter @mirfa/api... build",
  "functions": {
    "api/index.ts": {
      "runtime": "@vercel/node@3.2.2",
      "includeFiles": "packages/crypto/**",
      "config": {
        "esm": true
      }
    }
  },
  "rewrites": [
    {
      "source": "/(.*)",
      "destination": "/api"
    }
  ]
}

